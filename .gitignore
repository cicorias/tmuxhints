# --- Rust / Cargo ---
# Build output (Cargo.lock is committed: this is an application)
debug/
target/
**/target/
# Backup files generated by rustfmt
**/*.rs.bk
# Release bundles collected by `mise run dist`
/dist/
# Debug info from MSVC builds
*.pdb

# --- Tauri ---
# Generated capability schemas, regenerated on build
**/gen/schemas/

# --- mise ---
# Per-developer overrides of mise.toml
mise.local.toml
.mise.local.toml

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
