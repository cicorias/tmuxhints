# MSIX package identity, used by `cargo xtask msix`.
#
# Copy these from Partner Center > your app > Product management > Product identity.
# They are public (every installed package shows them), not secrets.
#
# The values below are placeholders: fine for building and testing locally,
# but Partner Center rejects an upload unless they match your reserved app.
IDENTITY_NAME=tmuxhints.dev
PUBLISHER=CN=tmuxhints-dev
PUBLISHER_DISPLAY_NAME=tmuxhints (dev build)
DISPLAY_NAME=tmuxhints
